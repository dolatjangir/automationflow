generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  admin
  manager
  agent
}

enum ContactStatus {
  new
  contacted
  qualified
  customer
  lost
}

enum JourneyStatus {
  draft
  active
  paused
  archived
}

enum JourneyNodeType {
  trigger
  delay
  whatsapp
  email
  sms
  condition
  assign
  end
}

enum ExecutionStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum LogLevel {
  info
  warning
  error
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String @id @default(cuid()) @db.VarChar(191)
  name         String @db.VarChar(191)
  email        String @unique @db.VarChar(191)
  passwordHash String @db.VarChar(255)

  role     UserRole @default(agent)
  isActive Boolean  @default(true)

  contacts        Contact[]
  createdJourneys Journey[] @relation("JourneyCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// ==========================================
// CONTACTS / LEADS
// ==========================================

model Contact {
  id String @id @default(cuid()) @db.VarChar(191)

  firstName String? @db.VarChar(100)
  lastName  String? @db.VarChar(100)
  email     String? @db.VarChar(191)
  phone     String? @db.VarChar(30)

  company  String? @db.VarChar(191)
  jobTitle String? @db.VarChar(191)

  source String? @db.VarChar(100)

  status ContactStatus @default(new)

  // Additional contact fields can be stored here.
  customFields Json?

  ownerId String? @db.VarChar(191)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  executions JourneyExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

// ==========================================
// JOURNEYS
// ==========================================

model Journey {
  id          String  @id @default(cuid()) @db.VarChar(191)
  name        String  @db.VarChar(191)
  description String? @db.Text

  status JourneyStatus @default(draft)

  // User who created this journey.
  createdById String? @db.VarChar(191)
  createdBy   User?   @relation("JourneyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  nodes      JourneyNode[]
  edges      JourneyEdge[]
  executions JourneyExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([updatedAt])
}

// ==========================================
// JOURNEY NODES
// ==========================================

model JourneyNode {
  id String @id @default(cuid()) @db.VarChar(191)

  journeyId String  @db.VarChar(191)
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  type        JourneyNodeType
  title       String          @db.VarChar(191)
  description String?         @db.Text

  // React Flow canvas position.
  positionX Float @default(0)
  positionY Float @default(0)

  // Node configuration: message, delay, condition, provider, etc.
  config Json?

  actionId String? @db.VarChar(191)
  category String? @db.VarChar(100)
  icon     String? @db.VarChar(100)
  color    String? @db.VarChar(50)

  outgoingEdges JourneyEdge[] @relation("EdgeSource")
  incomingEdges JourneyEdge[] @relation("EdgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([type])
}

// ==========================================
// JOURNEY EDGES / CONNECTIONS
// ==========================================

model JourneyEdge {
  id String @id @default(cuid()) @db.VarChar(191)

  journeyId String  @db.VarChar(191)
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  sourceNodeId String      @db.VarChar(191)
  sourceNode   JourneyNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  targetNodeId String      @db.VarChar(191)
  targetNode   JourneyNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  // For condition branches: yes, no, or default.
  sourceHandle String? @db.VarChar(50)
  targetHandle String? @db.VarChar(50)

  label    String? @db.VarChar(100)
  edgeType String? @db.VarChar(50)
  animated Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([journeyId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// ==========================================
// JOURNEY EXECUTIONS
// ==========================================

model JourneyExecution {
  id String @id @default(cuid()) @db.VarChar(191)

  journeyId String  @db.VarChar(191)
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  // Optional because test executions may not use a real CRM contact.
  contactId String?  @db.VarChar(191)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status ExecutionStatus @default(queued)

  // True for simulated/test executions; false for real executions.
  isTest Boolean @default(false)

  // Current node being processed by the execution engine.
  currentNodeId String? @db.VarChar(191)

  // Data received when the journey was triggered.
  triggerData Json?

  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  logs ExecutionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId, status])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// EXECUTION LOGS
// ==========================================

model ExecutionLog {
  id String @id @default(cuid()) @db.VarChar(191)

  executionId String           @db.VarChar(191)
  execution   JourneyExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId  String?  @db.VarChar(191)
  level   LogLevel @default(info)
  message String   @db.Text

  // Extra details such as API response or error information.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([nodeId])
  @@index([level])
  @@index([createdAt])
}
